#!/usr/bin/env python3
"""pre-commit hook: refuse to commit a schedule sheet carrying room assignments.

Rooms come from a logged-in SIS pull and are not public. The build already refuses
to compile a sheet that carries them, but a sheet can be hand-edited and committed
without ever being built -- and once a room reaches this repository it is on GitHub
and, five minutes later, on math.virginia.edu. So the same check runs here, against
the *staged* content rather than the working tree.

Costs nothing on an unrelated commit: it exits immediately unless a schedule source
is part of the change.

Install:
    ln -sf ../../scripts/schedule/pre-commit .git/hooks/pre-commit
"""

from __future__ import annotations

import pathlib
import re
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from schedule_build import assert_room_free                # noqa: E402

# schedule.tex and the archival per-term copies (f26.tex, s27.tex, su27.tex, ...)
SHEET = re.compile(r"^(schedule|(?:f|s|su|j)\d{2})\.tex$")


def staged_sheets() -> list[str]:
    out = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                         capture_output=True, text=True, check=True).stdout.split()
    return [p for p in out if SHEET.match(pathlib.PurePosixPath(p).name)]


def main() -> int:
    failed = False
    for path in staged_sheets():
        blob = subprocess.run(["git", "show", f":{path}"],
                              capture_output=True, text=True, check=True).stdout
        try:
            assert_room_free(blob, pathlib.Path(path))
        except SystemExit as e:
            print(f"pre-commit: refusing to commit {path}\n  {e}", file=sys.stderr)
            failed = True
    if failed:
        print("\nRooms are not public data. Empty the room argument, or commit with "
              "--no-verify only if you are certain this is not a room.", file=sys.stderr)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
