#!/usr/bin/env python3
"""pre-commit hook: refuse to commit a schedule sheet carrying room assignments.

Rooms come from a logged-in SIS pull and are not public. The build already refuses
to compile a sheet that carries them, but a sheet can be hand-edited and committed
without ever being built -- and once a room reaches this repository it is on GitHub
and, five minutes later, on math.virginia.edu. So the same check runs here, against
the *staged* content rather than the working tree.

Costs nothing on an unrelated commit: it exits immediately unless a schedule source
is part of the change.

Install:
    ln -sf ../../scripts/schedule/pre-commit .git/hooks/pre-commit
"""

from __future__ import annotations

import pathlib
import re
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from schedule_build import assert_room_free, assert_pdf_room_free, pdf_text  # noqa: E402

# The sheet under any name it is committed as. Deliberately loose: a room-bearing copy
# saved as schedule-rooms.tex or fall26.tex is exactly the accident worth catching, so
# anything that looks like a schedule sheet gets checked rather than only the two
# canonical names. --diff-filter includes R, because a rename plus an edit is a change.
SHEET = re.compile(r"(schedule|^(?:f|s|su|j)\d{2}$|fall|spring|summer)", re.I)


def staged_sheets() -> list[str]:
    out = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
                         capture_output=True, text=True, check=True).stdout.split()
    hits = []
    for p in out:
        name = pathlib.PurePosixPath(p).name
        stem, suffix = name.rsplit(".", 1) if "." in name else (name, "")
        if suffix.lower() in ("tex", "pdf") and SHEET.search(stem):
            hits.append(p)
    return hits


def main() -> int:
    failed = False
    for path in staged_sheets():
        blob = subprocess.run(["git", "show", f":{path}"],
                              capture_output=True, check=True).stdout
        # The name only decides what is worth opening; the content decides whether it
        # is really a schedule sheet, so an unrelated spring_seminar.tex is not failed
        # for lacking \PublicSchedule.
        try:
            if path.lower().endswith(".pdf"):
                text = pdf_text(blob)
                if text is None or "UVA Mathematics" not in text:
                    continue
                assert_pdf_room_free(blob, path)
            else:
                src = blob.decode("utf-8", "replace")
                if "\\Sx{" not in src and "PublicSchedule" not in src:
                    continue
                assert_room_free(src, pathlib.Path(path))
        except SystemExit as e:
            print(f"pre-commit: refusing to commit {path}\n  {e}", file=sys.stderr)
            failed = True
    if failed:
        print("\nRooms are not public data. Empty the room argument, or commit with "
              "--no-verify only if you are certain this is not a room.", file=sys.stderr)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
